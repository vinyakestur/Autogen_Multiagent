# Copy this file to .env and fill in your actual API keys and credentials

# Anthropic API Key (Required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LangSmith API Key (Optional - for tracing and monitoring)
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Databricks Configuration (Required)
DATABRICKS_SERVER_HOSTNAME=your_databricks_server_here
DATABRICKS_HTTP_PATH=your_http_path_here
DATABRICKS_ACCESS_TOKEN=your_access_token_here
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
